{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "LifeOS — Diseña tu futuro. Simula tus decisiones. Ejecuta tu vida.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-sql.mjs",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/check-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@picocss/pico": "^2.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
